# Database
POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Authentication - replace with at least 32 random characters
JWT_SECRET=replace-with-a-long-random-256-bit-secret
INTERNAL_API_KEY=replace-with-a-second-long-random-secret
ADMIN_EMAIL=admin@clinic.local
ADMIN_PASSWORD=ChangeMe123!

# Gemini - optional; deterministic fallbacks keep the application functional
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash-lite

# SMTP (Mailgun/SendGrid SMTP or any compatible provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@clinic.local
SMTP_ENABLED=false
NOTIFICATION_DRY_RUN=true

# Google Calendar OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/calendar/oauth/callback
GOOGLE_FRONTEND_SUCCESS_URI=http://localhost:5173/calendar-connected

# Public URLs
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8080
